{
  "name": "goose-api",
  "version": "2.1.0",
  "description": "Goose CMS API service",
  "author": "redgoose <scripter@me.com>",
  "module": "src/main.ts",
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev:util": "bun run --bun src/util.ts",
    "dev:preview": "bun run --bun src/main.ts",
    "prebuild": "rm -rf ./dist",
    "build": "bun run --bun ./src/build.ts",
    "prod:util": "bun run --bun dist/util.js",
    "prod:preview": "NODE_ENV=production bun run --bun dist/main.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "elysia": "^1.4.28",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/minimist": "^1.2.5",
    "minimist": "^1.2.8",
    "typescript": "^6.0.3"
  }
}
